# Copy to .env.local and fill in. Invalid values (e.g. PLC_PORT=abc) stop
# startup with an error instead of silently falling back to a default.

# ── MQTT ─────────────────────────────────────────────────────────────────────
# tcp://host:1883 (plain) or mqtts://host:8883 (TLS)
MQTT_HOST=mqtts://xxx.amazonaws.com:8883
# Topic prefix; the device address is appended: <MQTT_TOPIC>D100
MQTT_TOPIC=factory/line1/
# Must be unique per broker (AWS IoT disconnects duplicates). Default: msp-go-<hostname>
MQTT_CLIENT_ID=
# true: publish to <MQTT_TOPIC><plc>/<address> (e.g. factory/line1/secondary/D100)
# so the same address on both PLCs gets its own topic. Default false.
MQTT_TOPIC_INCLUDE_SOURCE=false
# true: only publish values that changed, plus a full refresh every
# PUBLISH_REFRESH_SEC seconds (0 = never refresh). Default false.
PUBLISH_ON_CHANGE=false
PUBLISH_REFRESH_SEC=60

# TLS: set MQTTS_ON=true, then EITHER certificate files (paths relative to
# /app in the container; the container runs as uid 65532, so the files
# must be readable by it) ...
MQTTS_ON=false
MQTT_CA_CERTIFICATE=certs/AmazonRootCA1.pem
MQTT_CLIENT_CERTIFICATE=certs/certificate.pem.crt
MQTT_PRIVATE_KEY=certs/private.pem.key
# ... OR the PEM contents themselves (e.g. injected from a parameter store).
# These win over the file paths when set.
# ECS_MQTT_CA_CERTIFICATE=
# ECS_MQTT_CLIENT_CERTIFICATE=
# ECS_MQTT_PRIVATE_KEY=

# true: no MQTT; values are copied between the PLCs using WRITE_MAP_* below.
MQTT_SKIP=false

# ── Polling ──────────────────────────────────────────────────────────────────
# Pause between read cycles in milliseconds. 0 = read continuously (old
# behaviour; every cycle costs PLC scan time).
POLL_INTERVAL_MS=0

# ── Main PLC (Mitsubishi) ─────────────────────────────────────────────────────
MAIN_PLC_BRAND=mitsubishi
PLC_HOST=192.168.3.21
PLC_PORT=5012
# true = FX series (1E frame), false = iQ-R/Q series (3E frame)
PLC_MODEL=false

# DEVICES_*: comma-separated TYPE,NUMBER,DATATYPE triples, e.g. D,100,1
# DATATYPE: 1 uint16 | 2 float32 | 3 bit | 4 text | 5 int16 | 6 FX x10 | 7 int32
# X, Y, B, W numbers are hex (X,3E,3); the others are decimal.
# Supported types: X Y M L F V B W D (3E) — an unsupported type stops startup.
DEVICES_16bit=D,0,1,D,1,1,D,2,1,D,3,1
DEVICES_32bit=D,650,2,D,676,2
DEVICES_2bit=M,24,3,M,25,3
DEVICES_ASCII=
# Text registers (type 4): auto = ASCII + Shift-JIS kanji (GOT default),
# unicode = UTF-16 (GOT "Unicode" string devices). Default: auto
TEXT_ENCODING=auto
# BLOCK_READ: group DEVICES_* into batch reads (Mitsubishi 3E only; ignored when PLC_MODEL=true).
# Each MC request costs ~1 PLC scan, so 140 single reads ≈ 140 scans; blocks cut that to a handful.
# Startup log prints the plan: "PLC main block read: 140 devices -> N requests/cycle".
BLOCK_READ=false
# BLOCK_MAX_GAP: unused words allowed between devices before starting a new block (default 128).
# Bigger = fewer requests, slightly larger responses. 0 = default.
BLOCK_MAX_GAP=0

# ── Writes between PLCs (MQTT_SKIP=true only) ────────────────────────────────
# WRITE_MAP_SEC_TO_PRIM: values written INTO the main PLC.
#
# Format: entries separated by ';', each
#   SRC>TYPE,NUMBER[,WRITETYPE[,REGS]]
#   │    └─ target device on the main PLC
#   └─ address as read (from either PLC's DEVICES_*), no comma: D100, X3E
#
#   WRITETYPE (default 1): 1 uint16 | 2 float32 | 3 bit | 4 ASCII | 5 int16 | 6 FX x10
#   REGS      (default 1): registers per write request
#
# Examples:
#   WRITE_MAP_SEC_TO_PRIM=D100>D,200          read D100, write it to main D200
#   WRITE_MAP_SEC_TO_PRIM=D100>D,200,1,1;D101>D,201;X3E>M,70,3
#   One source may have several targets: D100>D,200;D100>D,300
#
# Unconditional writes skip zero values for word targets; bit targets
# (WRITETYPE 3) follow the source ON and OFF. A malformed entry stops startup.
WRITE_MAP_SEC_TO_PRIM=

# WRITE_MAP_SEC_TO_PRIM_CONDITION: interlocks for the writes above.
# When set, EVERY source in WRITE_MAP_SEC_TO_PRIM needs a rule — a source
# without one is never written.
#
# Format: rules separated by ';', each
#   BIT==SRC   write SRC to its main-PLC targets while BIT is 1
#   BIT!=SRC   write SRC to its main-PLC targets while BIT is not 1
# BIT and SRC are addresses as read (no commas). BIT must be in a DEVICES_*
# list. Values older than 30 s (or 3 poll intervals), or from a PLC that
# became unreachable, are ignored, so a stale bit can't release writes.
#
# Examples:
#   M64==D100            write D100 only while M64 = 1 (machine running)
#   M64==D100;M30!=D101  D100 while M64 = 1, D101 while M30 is not 1
#
WRITE_MAP_SEC_TO_PRIM_CONDITION=

# ── Secondary PLC (Shibaura, experimental, read-only) ─────────────────────────
SUB_PLC_BRAND=shibaura
SEC_PLC_HOST=
# Shibaura: try 502 (Modbus) first
SEC_PLC_PORT=502
# Mitsubishi secondary only: true = FX series. Defaults to PLC_MODEL if unset.
SEC_PLC_MODEL=
# NOTE for Shibaura: the third field is a COUNT of registers/bits to read
# (value published as a list), not the Mitsubishi DATATYPE code.
SEC_DEVICES_16bit=D,0,1,D,1,1
SEC_DEVICES_32bit=
SEC_DEVICES_2bit=
SEC_DEVICES_ASCII=
SEC_TEXT_ENCODING=auto
# Same as BLOCK_READ / BLOCK_MAX_GAP, for the secondary PLC (only applies if it is Mitsubishi).
SEC_BLOCK_READ=false
SEC_BLOCK_MAX_GAP=0

# WRITE_MAP_PRIM_TO_SEC / _CONDITION: the reverse direction, values written
# INTO the secondary PLC. Same format as above. Writes to Shibaura are
# disabled, so these only work when the secondary PLC is Mitsubishi.
#   WRITE_MAP_PRIM_TO_SEC=D200>D,100
WRITE_MAP_PRIM_TO_SEC=
WRITE_MAP_PRIM_TO_SEC_CONDITION=

# ── Diagnostics ──────────────────────────────────────────────────────────────
# pprof on 127.0.0.1:<port> inside the container; 0 = off (default)
PPROF_PORT=0
# true: print messages/second to stdout every second
PERF_MONITOR=false
